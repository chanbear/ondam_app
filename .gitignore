# Environment secrets
.env

# Claude Code personal/machine-specific files
CLAUDE.local.md
.claude/settings.local.json

# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
build/
coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
android/app/debug
android/app/profile
android/app/release

# Monorepo (pub workspace): only the root pubspec.lock is meaningful — pub
# itself deletes stray per-member lockfiles, but ignore them defensively too.
# See https://dart.dev/go/workspaces-stray-files
apps/*/pubspec.lock
packages/*/pubspec.lock

# Supabase CLI local link/session state (`supabase link`) — machine-specific,
# not project config.
supabase/.temp/

# tools/cc_console (local project console) — Python build artifacts.
__pycache__/
*.pyc
